{
  "manifest_version": 3,
  "name": "Berriz Downloader",
  "version": "2.1.1",
  "description": "Berriz 영상·오디오 스트림을 찾아 원본 화질의 TS 파일로 저장합니다.",
  "key": "",
  "permissions": [
    "webRequest",
    "storage",
    "offscreen",
    "downloads",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://berriz.in/*",
    "https://*.berriz.in/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Berriz 영상 TS 저장",
    "default_popup": "manager.html?popup=1"
  },
  "content_scripts": [
    {
      "matches": [
        "https://berriz.in/*",
        "https://*.berriz.in/*"
      ],
      "js": [
        "replay-info.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "minimum_chrome_version": "116"
}
